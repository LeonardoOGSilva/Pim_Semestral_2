<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Voxtech" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cor da Status Bar (topo onde fica a bateria e hora) -->
        <item name="android:statusBarColor">#09070F</item>
        <!-- Cor da barra inferior de navegação do Android -->
        <item name="android:navigationBarColor">#09070F</item>
        <!-- Garante que os ícones da Status Bar fiquem brancos -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- Mantém o conteúdo abaixo da barra de status (evita o cabeçalho sob o relógio) -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="Theme.Voxtech" parent="Base.Theme.Voxtech" />

    <!-- Rótulo pequeno acima dos campos de formulário -->
    <style name="RotuloCampo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">#9D95AA</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Campo de digitação escuro e arredondado -->
    <style name="CampoTexto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">#1A1526</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#5E566E</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
